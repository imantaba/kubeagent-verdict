.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
out/
dist/
# `train.md` step 2 parks the previous release's model as dist-v<N>-superseded/
# so nothing downstream picks it up; that directory holds a multi-hundred-MB
# GGUF and must be ignored as thoroughly as dist/ itself.
dist-*-superseded/
build/
models/
artifacts/
*.gguf
*.egg-info/
# Subagent-driven-development scratch: per-plan ledger, task briefs, implementer
# reports and review packages. Recoverable from git log, never part of it.
.superpowers/

# Export directories for retrain candidates. Each holds a multi-GB GGUF;
# only dist/ is the shipped one and it is already ignored above.
dist-retrain-*/
